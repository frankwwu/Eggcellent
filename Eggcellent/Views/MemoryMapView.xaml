<UserControl x:Class="Eggcellent.Views.MemoryMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <UserControl.Resources>
        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Width" Value="190"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource EggcellentTextMuted}"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource EggcellentTextPrimary}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Memory Map" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="A live look at physical memory: what's using it, and tools to reclaim it." Style="{StaticResource SectionSubtitle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <CheckBox Content="Auto-refresh" IsChecked="{Binding AutoRefresh}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryActionButton}"/>
            </StackPanel>
        </Grid>

        <WrapPanel Grid.Row="1">
            <Border Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Text="Physical Memory In Use" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding Snapshot.PhysicalInUseDisplay}" Style="{StaticResource StatValue}"/>
                    <ProgressBar Value="{Binding Snapshot.PhysicalInUsePercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="6" Margin="0,8,0,0"/>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource EggcellentTextMuted}">
                        <Run Text="{Binding Snapshot.PhysicalAvailableDisplay, Mode=OneWay}"/>
                        <Run Text=" free of "/>
                        <Run Text="{Binding Snapshot.PhysicalTotalDisplay, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Text="System Cache (Standby)" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding Snapshot.SystemCacheDisplay}" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="Cached file data — safe to reclaim" FontSize="11" Foreground="{StaticResource EggcellentTextMuted}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Text="Committed Memory" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding Snapshot.CommitTotalDisplay}" Style="{StaticResource StatValue}"/>
                    <ProgressBar Value="{Binding Snapshot.CommitPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="6" Margin="0,8,0,0"/>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource EggcellentTextMuted}">
                        <Run Text="of "/>
                        <Run Text="{Binding Snapshot.CommitLimitDisplay, Mode=OneWay}"/>
                        <Run Text=" limit"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Text="Kernel Pool" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding Snapshot.KernelPagedDisplay}" Style="{StaticResource StatValue}"/>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource EggcellentTextMuted}">
                        <Run Text="{Binding Snapshot.KernelNonpagedDisplay, Mode=OneWay}"/>
                        <Run Text=" nonpaged"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Text="Processes / Threads" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding Snapshot.ProcessCount}" Style="{StaticResource StatValue}"/>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource EggcellentTextMuted}">
                        <Run Text="{Binding Snapshot.ThreadCount, Mode=OneWay}"/>
                        <Run Text=" threads · "/>
                        <Run Text="{Binding Snapshot.HandleCount, Mode=OneWay}"/>
                        <Run Text=" handles"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Memory actions" FontWeight="SemiBold" Foreground="{StaticResource EggcellentTextPrimary}" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Button Content="Empty Standby List" Command="{Binding EmptyStandbyListCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,10,10"/>
                    <Button Content="Empty Priority 0 Standby List" Command="{Binding EmptyPriority0StandbyListCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,10,10"/>
                    <Button Content="Flush Modified Page List" Command="{Binding FlushModifiedListCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,10,10"/>
                    <Button Content="Empty All Working Sets" Command="{Binding EmptyAllWorkingSetsCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,10,10"/>
                    <mah:ProgressRing IsActive="{Binding IsBusy}" Width="20" Height="20" Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Process" FontWeight="SemiBold" Foreground="{StaticResource EggcellentTextMuted}" FontSize="11"/>
                    <TextBlock Grid.Column="1" Text="Working Set" FontWeight="SemiBold" Foreground="{StaticResource EggcellentTextMuted}" FontSize="11"/>
                    <TextBlock Grid.Column="2" Text="Private Bytes" FontWeight="SemiBold" Foreground="{StaticResource EggcellentTextMuted}" FontSize="11"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Processes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource EggcellentBorder}" BorderThickness="0,0,0,1" Padding="14,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Foreground="{StaticResource EggcellentTextPrimary}">
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                            <Run Text=" ("/>
                                            <Run Text="{Binding ProcessId, Mode=OneWay}"/>
                                            <Run Text=")"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding WorkingSetDisplay}" Foreground="{DynamicResource MahApps.Brushes.Accent}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PrivateBytesDisplay}" Foreground="{StaticResource EggcellentTextMuted}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding Status}" Margin="0,14,0,0" Foreground="{StaticResource EggcellentTextMuted}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
