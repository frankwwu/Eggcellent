<UserControl x:Class="Eggcellent.Views.UninstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Uninstaller" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="See everything installed on this PC and remove what you don't need." Style="{StaticResource SectionSubtitle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <mah:ProgressRing IsActive="{Binding IsBusy}" Width="20" Height="20" Margin="0,0,10,0" Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryActionButton}"/>
            </StackPanel>
        </Grid>

        <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 mah:TextBoxHelper.Watermark="Search installed programs..."
                 mah:TextBoxHelper.ClearTextButton="True"
                 Padding="10,8" Margin="0,0,0,14"/>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource EggcellentBorder}" BorderThickness="0,0,0,1" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource EggcellentTextPrimary}"/>
                                        <TextBlock Foreground="{StaticResource EggcellentTextMuted}" FontSize="11">
                                            <Run Text="{Binding Publisher, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Version, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="{DynamicResource MahApps.Brushes.Accent}" FontWeight="SemiBold"/>
                                    <Button Grid.Column="2" Content="Uninstall"
                                            Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DangerActionButton}" Padding="14,7"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,14,0,0" Foreground="{StaticResource EggcellentTextMuted}"/>
    </Grid>
</UserControl>
