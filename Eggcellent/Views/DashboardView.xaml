<UserControl x:Class="Eggcellent.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="Dashboard" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="An overview of your system's storage and junk." Style="{StaticResource SectionSubtitle}"/>

            <ItemsControl ItemsSource="{Binding Drives}" Margin="0,20,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource EggcellentTextPrimary}"/>
                                    <TextBlock Grid.Column="1">
                                        <Run Text="{Binding UsedDisplay, Mode=OneWay}"/>
                                        <Run Text=" of "/>
                                        <Run Text="{Binding TotalDisplay, Mode=OneWay}"/>
                                        <Run Text=" used"/>
                                    </TextBlock>
                                </Grid>
                                <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Margin="0,10,0,4"/>
                                <TextBlock Text="{Binding FreeDisplay, StringFormat='{}{0} free'}" FontSize="12" Foreground="{StaticResource EggcellentTextMuted}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Quick Scan" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource EggcellentTextPrimary}"/>
                    <TextBlock Text="{Binding JunkSummary}" Margin="0,6,0,14" Foreground="{StaticResource EggcellentTextMuted}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Quick Scan" Command="{Binding QuickScanCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,10,0"/>
                        <Button Content="Open Smart Clean" Command="{Binding GoToCleanerCommand}" Style="{StaticResource PrimaryActionButton}"/>
                        <mah:ProgressRing IsActive="{Binding IsBusy}" Width="22" Height="22" Margin="14,0,0,0" Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
