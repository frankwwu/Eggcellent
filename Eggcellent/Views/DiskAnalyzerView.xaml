<UserControl x:Class="Eggcellent.Views.DiskAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Disk Analyzer" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Drill into any folder to see what's taking up the most space." Style="{StaticResource SectionSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Up" Command="{Binding UpCommand}" Style="{StaticResource PrimaryActionButton}" Padding="12,8" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Text="{Binding CurrentPath}" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,10,0"/>
                <mah:ProgressRing Grid.Column="3" IsActive="{Binding IsBusy}" Width="22" Height="22" Margin="0,0,14,0" Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                <Button Grid.Column="4" Content="Scan" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryActionButton}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource EggcellentBorder}" BorderThickness="0,0,0,1" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{Binding Name}" Style="{StaticResource LinkButton}"
                                            Command="{Binding DataContext.DrillDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding IsFolder}" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Value="{Binding PercentOfParent, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                                    <Button Grid.Column="3" Content="Open"
                                            Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PrimaryActionButton}" Padding="10,5"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,14,0,0" Foreground="{StaticResource EggcellentTextMuted}"/>
    </Grid>
</UserControl>
