<UserControl x:Class="Eggcellent.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Startup Manager" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Control which apps launch automatically when Windows starts." Style="{StaticResource SectionSubtitle}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryActionButton}" VerticalAlignment="Bottom"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource EggcellentBorder}" BorderThickness="0,0,0,1" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource EggcellentTextPrimary}"/>
                                        <TextBlock Text="{Binding Command}" FontSize="11" Foreground="{StaticResource EggcellentTextMuted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding HiveDisplay}" FontSize="11" Foreground="{StaticResource EggcellentTextMuted}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <Button Grid.Column="2" Content="{Binding ToggleLabel}"
                                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PrimaryActionButton}" Padding="12,6" Margin="0,0,10,0"/>
                                    <Button Grid.Column="3" Content="Remove"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PrimaryActionButton}" Padding="12,6"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="0,14,0,0" Foreground="{StaticResource EggcellentTextMuted}"/>
    </Grid>
</UserControl>
